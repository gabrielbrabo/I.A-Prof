PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/iaprof
CLIENT_URL=http://localhost:5173

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado na geracao (troque se quiser outro)
ANTHROPIC_MODEL=claude-sonnet-5-5
# (opcional) modelo so para escolher as habilidades. Ex.: claude-opus-5-5 (mais preciso, ~2x o custo dessa etapa)
ANTHROPIC_MODEL_ESCOLHA=
# Modelo das ATIVIDADES (gerar e ajustar). Vazio = ANTHROPIC_MODEL. claude-opus-5-5 = atividades mais caprichadas (~2,5x o custo)
# Correcao de atividades: objetivas no modelo barato; discursivas (vazio = ANTHROPIC_MODEL)
ANTHROPIC_MODEL_CORRECAO_OBJETIVA=claude-haiku-4-5
ANTHROPIC_MODEL_CORRECAO_DISCURSIVA=

# Limites de caracteres
# Maximo que o professor pode digitar na entrada (controla custo)
LIMITE_ENTRADA_CHARS=1000
# Maximo do texto final do registro de aula (campo do diario). 0 = sem limite
LIMITE_REGISTRO_CHARS=2000

# Imagens das atividades (ilustracoes geradas pela OpenAI). Vazio = atividades usam so emojis/desenhos simples.
# gpt-image-1-mini: ~US$ 0,005 (low) / 0,011 (medium) / 0,036 (high) por imagem 1024x1024
# OpenAI: gera e ajusta as atividades (texto) e as imagens. Obrigatoria para Atividades.
OPENAI_API_KEY=
OPENAI_MODEL_ATIVIDADE=gpt-6.1-sol
OPENAI_RACIOCINIO=medium
IMAGEM_MODELO=gpt-image-2.5-flare
IMAGEM_QUALIDADE=medium
IMAGEM_MAX=8
IMAGEM_CUSTO_USD=

# Ditado por voz nos navegadores sem reconhecimento proprio (Firefox, Brave, Opera...).
# Chrome/Edge/Safari usam o do navegador (gratis). Chave em console.groq.com (custo ~US$ 0,04 por hora de audio)
GROQ_API_KEY=
GROQ_MODELO_VOZ=whisper-large-v3-turbo
# Sem GROQ_API_KEY o ditado (tablet/iPhone/Firefox) usa a OpenAI com a OPENAI_API_KEY
OPENAI_MODELO_VOZ=gpt-4o-mini-transcribe

# Login (troque por um texto grande e aleatorio em producao)
JWT_SECRET=troque-este-segredo
# Login com Google: ID do cliente OAuth (tipo "Aplicativo da Web") em console.cloud.google.com
GOOGLE_CLIENT_ID=
# Cotacao do dolar usada para calcular o custo de I.A de cada professor (limite do plano)
COTACAO_DOLAR=5.3

# Creditos extras de I.A (compra avulsa). FATOR: quanto de cada R$ 1 pago vira custo real de I.A (0.5 = metade)
CREDITO_FATOR=0.5
CREDITO_MINIMO_CENTAVOS=1000
CREDITO_MAXIMO_CENTAVOS=50000

# Assinatura (Asaas). Deixe PAYMENTS_PROVIDER vazio em desenvolvimento: assinar libera na hora, sem cobrar.
PAYMENTS_PROVIDER=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
PAYMENTS_WEBHOOK_SECRET=

# Diario escolar (X Escolar): endereco da API do Diario e a MESMA chave colocada em IAPROF_CHAVE no Diario
DIARIO_API_URL=
DIARIO_CHAVE=
